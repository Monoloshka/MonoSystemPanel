{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MonoSystemPanel",
  "version": "0.1.0",
  "identifier": "com.monoloshka.monosystempanel",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MonoSystemPanel",
        "width": 1000,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Управление устройствами по SSH",
    "longDescription": "Приложение рисует кнопки, поля и списки служб по текстовому описанию и выполняет команды на сервере по SSH.",
    "copyright": "© 2026 Dmitriy Yakovenko (Monoloshka)",
    "license": "MIT"
  },
  "mainBinaryName": "monosystempanel"
}